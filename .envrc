source .venv/bin/activate

# No FPL_CACHE_DIR here. Nothing in the codebase has ever read it — every cache
# path is hardcoded under ~/.fpl-cli (storage/cache.py, api/snapshots.py), and
# the only environment variable the CLI consults is FPL_SNAPSHOT. It was
# exported here set to the same value as the hardcoded default, so it never had
# an observable effect; a variable that appears to redirect the caches and does
# not is worse than no variable at all. Isolate a test sync with
# `fpl sync --archive-dir`. See FU-42.
